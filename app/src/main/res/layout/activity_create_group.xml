<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".CreateGroupActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="חזרה"
                android:src="@drawable/ic_arrow_forward" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="קבוצה חדשה"
            android:textAlignment="viewStart"
            android:textColor="@color/home_navy"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Group name -->
            <TextView
                style="@style/CreateGroupSectionTitle"
                android:layout_marginTop="8dp"
                android:text="שם הקבוצה" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/login_stroke"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etGroupName"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:autofillHints="name"
                    android:background="@null"
                    android:hint="למשל: דירה בתל אביב"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:paddingHorizontal="20dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/home_navy"
                    android:textColorHint="@color/home_muted"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="viewStart"
                android:textColor="@color/home_negative"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Icon picker -->
            <TextView
                style="@style/CreateGroupSectionTitle"
                android:layout_marginTop="24dp"
                android:text="אייקון" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:outlineSpotShadowColor="@color/home_shadow"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIcons"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:clipToPadding="true"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Members -->
            <TextView
                style="@style/CreateGroupSectionTitle"
                android:layout_marginTop="24dp"
                android:text="חברי הקבוצה" />

            <LinearLayout
                android:id="@+id/membersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/login_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autofillHints="name"
                        android:background="@null"
                        android:hint="חיפוש לפי שם"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/home_navy"
                        android:textColorHint="@color/home_muted"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/progressSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="12dp"
                        android:indeterminateTint="@color/home_primary"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/btnSearch"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_search" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSearchMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="viewStart"
                android:textColor="@color/home_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Height is set in code: rows * 64dp, capped at 3 rows; scrolls internally beyond that -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="viewStart"
                android:textColor="@color/home_negative"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:text="צור קבוצה"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/home_primary"
        app:cornerRadius="18dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".GroupDetailsActivity">

    <!-- Header: back, group icon, name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="חזרה"
                android:src="@drawable/ic_arrow_forward" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvGroupIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_group_icon"
            android:gravity="center"
            android:textSize="26sp"
            android:visibility="gone"
            tools:text="🌸"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/home_navy"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="גינה של הבניינים אורים 6" />

        <!-- Shown only to the group's creator (the only person the server lets delete it). -->
        <ImageView
            android:id="@+id/btnDeleteGroup"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="מחק קבוצה"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLoad"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="@color/home_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/errorGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/home_negative"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="נסי שוב"
            app:backgroundTint="@color/home_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Group balance card (opens the canonical My Balance screen) -->
            <FrameLayout
                android:id="@+id/groupBalanceCard"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_balance_card"
                android:clipToOutline="true"
                android:elevation="6dp"
                android:outlineSpotShadowColor="@color/home_shadow">

                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="-40dp"
                    android:layout_marginTop="-50dp"
                    android:background="@drawable/bg_circle_translucent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="המאזן שלך בקבוצה"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGroupBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        tools:text="+₪300.00" />

                    <TextView
                        android:id="@+id/tvBalanceError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Members -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CreateGroupSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="חברי הקבוצה" />

                <TextView
                    android:id="@+id/btnAddMember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_me"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="+ הוסף חבר"
                    android:textColor="@color/home_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:outlineSpotShadowColor="@color/home_shadow"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/membersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Expenses -->
            <TextView
                style="@style/CreateGroupSectionTitle"
                android:layout_marginTop="22dp"
                android:text="הוצאות" />

            <TextView
                android:id="@+id/tvExpensesError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAlignment="viewStart"
                android:textColor="@color/home_negative"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmptyExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="אין עדיין הוצאות בקבוצה"
                android:textColor="@color/home_navy"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpense"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:text="הוסף הוצאה"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/home_primary"
        app:cornerRadius="18dp" />
</LinearLayout>
